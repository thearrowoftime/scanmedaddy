<!--
  netaudit rules for Wazuh 4.x

  Install on the Wazuh manager:
    sudo install -o wazuh -g wazuh -m 0640 netaudit_rules.xml \
      /var/ossec/etc/rules/netaudit_rules.xml
    sudo systemctl restart wazuh-manager

  Two base rules exist because netaudit supports two transports:
    100500  file transport   (agent localfile, log_format=json -> decoder "json")
    100501  syslog transport (decoder "netaudit", see decoders/netaudit_decoders.xml)

  Everything else keys off those via <if_sid>100500,100501</if_sid>.
-->
<group name="netaudit,config_audit,">

  <rule id="100500" level="3">
    <decoded_as>json</decoded_as>
    <field name="integration">^netaudit$</field>
    <description>netaudit event (file transport)</description>
    <options>no_full_log</options>
  </rule>

  <rule id="100501" level="3">
    <decoded_as>netaudit</decoded_as>
    <field name="integration">^netaudit$</field>
    <description>netaudit event (syslog transport)</description>
    <options>no_full_log</options>
  </rule>

  <!-- Severity mapping for audit findings -->
  <rule id="100510" level="12">
    <if_sid>100500,100501</if_sid>
    <field name="netaudit.event_type">^finding$</field>
    <field name="netaudit.severity">^critical$</field>
    <description>netaudit CRITICAL: $(netaudit.title) on $(netaudit.device)</description>
    <group>gdpr_IV_35.7.d,pci_dss_2.2,</group>
  </rule>

  <rule id="100511" level="10">
    <if_sid>100500,100501</if_sid>
    <field name="netaudit.event_type">^finding$</field>
    <field name="netaudit.severity">^high$</field>
    <description>netaudit HIGH: $(netaudit.title) on $(netaudit.device)</description>
    <group>pci_dss_2.2,</group>
  </rule>

  <rule id="100512" level="7">
    <if_sid>100500,100501</if_sid>
    <field name="netaudit.event_type">^finding$</field>
    <field name="netaudit.severity">^medium$</field>
    <description>netaudit MEDIUM: $(netaudit.title) on $(netaudit.device)</description>
  </rule>

  <rule id="100513" level="5">
    <if_sid>100500,100501</if_sid>
    <field name="netaudit.event_type">^finding$</field>
    <field name="netaudit.severity">low|info</field>
    <description>netaudit LOW/INFO: $(netaudit.title) on $(netaudit.device)</description>
  </rule>

  <!-- High-signal specific findings -->
  <rule id="100520" level="12">
    <if_sid>100500,100501</if_sid>
    <field name="netaudit.rule_id">FG-POLICY-ANY-ANY|ACL-PERMIT-ANY|SC-ACL-PERMIT-ANY</field>
    <description>netaudit: overly permissive firewall/ACL on $(netaudit.device)</description>
  </rule>

  <rule id="100521" level="10">
    <if_sid>100500,100501</if_sid>
    <field name="netaudit.rule_id">FG-SYSLOG-MISSING|SYSLOG-MISSING|SC-SYSLOG-MISSING</field>
    <description>netaudit: $(netaudit.device) is not sending syslog (SIEM blind spot)</description>
  </rule>

  <rule id="100522" level="10">
    <if_sid>100500,100501</if_sid>
    <field name="netaudit.rule_id">FG-TELNET-ADMIN|TELNET-ENABLED|SC-TELNET-ENABLED</field>
    <description>netaudit: cleartext management (telnet) enabled on $(netaudit.device)</description>
  </rule>

  <!-- Operational events: the backup pipeline itself -->
  <rule id="100530" level="10">
    <if_sid>100500,100501</if_sid>
    <field name="netaudit.event_type">^backup_failed$</field>
    <description>netaudit: config backup FAILED for $(netaudit.device) after $(netaudit.attempts) attempt(s)</description>
    <group>service_availability,</group>
  </rule>

  <rule id="100531" level="7">
    <if_sid>100500,100501</if_sid>
    <field name="netaudit.event_type">^config_changed$</field>
    <description>netaudit: configuration changed on $(netaudit.device)</description>
  </rule>

  <rule id="100532" level="3">
    <if_sid>100500,100501</if_sid>
    <field name="netaudit.event_type">^run_summary$</field>
    <description>netaudit run summary: $(netaudit.detail)</description>
    <options>no_full_log</options>
  </rule>

  <rule id="100533" level="10">
    <if_sid>100532</if_sid>
    <field name="netaudit.severity">^high$</field>
    <description>netaudit run finished with failures: $(netaudit.detail)</description>
    <group>service_availability,</group>
  </rule>

  <!-- Repeated backup failures for the same device: likely credential or link problem -->
  <rule id="100540" level="12" frequency="3" timeframe="86400">
    <if_matched_sid>100530</if_matched_sid>
    <same_field>netaudit.device</same_field>
    <description>netaudit: repeated backup failures for $(netaudit.device) in 24h</description>
    <group>service_availability,</group>
  </rule>

  <!--
    SSH host key events. A changed key on a device that was not replaced means
    either an unannounced rebuild or traffic interception, so it is rated above
    every configuration finding.
  -->
  <rule id="100550" level="14">
    <if_sid>100500,100501</if_sid>
    <field name="netaudit.event_type">^host_key_changed$</field>
    <description>netaudit: SSH host key CHANGED for $(netaudit.target) - possible interception or unannounced device replacement</description>
    <group>attack,invalid_login,</group>
  </rule>

  <rule id="100551" level="5">
    <if_sid>100500,100501</if_sid>
    <field name="netaudit.event_type">^host_key_unpinned$</field>
    <description>netaudit: SSH host key for $(netaudit.target) is not pinned yet</description>
  </rule>

  <rule id="100552" level="3">
    <if_sid>100500,100501</if_sid>
    <field name="netaudit.event_type">^host_key_learned$</field>
    <description>netaudit: pinned SSH host key for $(netaudit.target)</description>
    <options>no_full_log</options>
  </rule>

  <!-- Active response outcomes -->
  <rule id="100560" level="4">
    <if_sid>100500,100501</if_sid>
    <field name="netaudit.event_type">^respond_summary$</field>
    <description>netaudit active response: $(netaudit.detail)</description>
    <options>no_full_log</options>
  </rule>

  <rule id="100561" level="10">
    <if_sid>100500,100501</if_sid>
    <field name="netaudit.event_type">^respond_failed$</field>
    <description>netaudit active response could not back up $(netaudit.device): $(netaudit.detail)</description>
    <group>service_availability,</group>
  </rule>

  <!-- Baseline drift and patch level -->
  <rule id="100570" level="8">
    <if_sid>100500,100501</if_sid>
    <field name="netaudit.rule_id">^BASELINE-</field>
    <description>netaudit: $(netaudit.device) drifted from the approved baseline - $(netaudit.title)</description>
    <group>config_changed,</group>
  </rule>

  <rule id="100571" level="10">
    <if_sid>100500,100501</if_sid>
    <field name="netaudit.rule_id">^FW-OUTDATED$</field>
    <description>netaudit: $(netaudit.device) runs firmware below the accepted minimum - $(netaudit.detail)</description>
    <group>vulnerability-detector,</group>
  </rule>

</group>
